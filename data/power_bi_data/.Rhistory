updateR()
# Load necessary libraries
library(DBI)
library(RSQLite)
library(dplyr)
### ------------------------------------------------------------------------- ###
### 1. SETUP CONNECTION TO SQLITE DATABASES                                   ###
### ------------------------------------------------------------------------- ###
# IMPORTANT: Replace these paths with the actual locations of your database files.
db_path_main <- "C:\\Users\\durki\\OneDrive\\Desktop\\gooner part 1 html converter\\output\\logs.db"
db_path_attached_1 <- "C:\\Users\\durki\\OneDrive\\Desktop\\gooner part 2 html converter\\output\\logs.db"
db_path_attached_2 <- "C:\\Users\\durki\\OneDrive\\Desktop\\gooner part 3 html converter\\output\\logs.db"
# Establish connection to the main database
con <- dbConnect(RSQLite::SQLite(), dbname = db_path_main)
message(paste("Successfully connected to the main database:", db_path_main))
# Attach the other databases with unique aliases
dbExecute(con, paste0("ATTACH DATABASE '", db_path_attached_1, "' AS attached_db_1;"))
message(paste("Successfully attached database:", db_path_attached_1))
dbExecute(con, paste0("ATTACH DATABASE '", db_path_attached_2, "' AS attached_db_2;"))
message(paste("Successfully attached database:", db_path_attached_2))
### ------------------------------------------------------------------------- ###
### 2. DEFINE AND EXECUTE THE SQL QUERY                                       ###
### ------------------------------------------------------------------------- ###
# This query combines, cleans, and deduplicates the data from all attached databases.
# IMPORTANT: Verify the table names (e.g., html_logs_f2ea78cf) match your actual tables.
sql_query <- "
WITH CombinedBroadcasts AS (
-- Combine all source tables into a single dataset
SELECT
Timestamp, Message_Content, Broadcast_Metadata, SRP, Broadcast_Audience, Broadcast_Type,
Broadcaster_Username, COMMS, DOCTRINE, FC_NAME, FORMUP_LOCATION,
OP, PAP_TYPE, SHIPS, 'html_logs_3c45c0f5' AS Original_Table
FROM html_logs_3c45c0f5
UNION ALL
SELECT
Timestamp, Message_Content, Broadcast_Metadata, SRP, Broadcast_Audience, Broadcast_Type,
Broadcaster_Username, COMMS, DOCTRINE, FC_NAME, FORMUP_LOCATION,
OP, PAP_TYPE, SHIPS, 'html_logs_67820155' AS Original_Table
FROM html_logs_67820155 -- Note the use of the alias 'attached_db_1'
UNION ALL
SELECT
Timestamp, Message_Content, Broadcast_Metadata, SRP, Broadcast_Audience, Broadcast_Type,
Broadcaster_Username, COMMS, DOCTRINE, FC_NAME, FORMUP_LOCATION,
OP, PAP_TYPE, SHIPS, 'html_logs_59518e0a' AS Original_Table
FROM html_logs_59518e0a -- Note the use of the alias 'attached_db_2'
),
ParsedBroadcasts AS (
-- Extract and clean the timestamp from the metadata string
SELECT
*,
CASE
WHEN INSTR(Broadcast_Metadata, ' at ') > 0
THEN SUBSTR(Broadcast_Metadata, INSTR(Broadcast_Metadata, ' at ') + 4, 19)
ELSE NULL
END AS Extracted_Timestamp_str
FROM CombinedBroadcasts
),
TimeCalculatedBroadcasts AS (
-- Calculate the time difference between potentially duplicate fleet announcements
SELECT
*,
LAG(Extracted_Timestamp_str, 1) OVER (
PARTITION BY Broadcaster_Username, FC_NAME, DOCTRINE, PAP_TYPE
ORDER BY Extracted_Timestamp_str
) as prev_timestamp_str
FROM ParsedBroadcasts
WHERE Extracted_Timestamp_str IS NOT NULL
)
-- Final result: Select only the broadcasts that are not near-duplicates
SELECT
Timestamp, Message_Content, Broadcast_Metadata, SRP, Broadcast_Audience, Broadcast_Type,
Broadcaster_Username, COMMS, DOCTRINE, FC_NAME, FORMUP_LOCATION,
OP, PAP_TYPE, SHIPS, Original_Table,
Extracted_Timestamp_str AS Extracted_Timestamp
FROM
TimeCalculatedBroadcasts
WHERE
prev_timestamp_str IS NULL
OR (strftime('%s', Extracted_Timestamp_str) - strftime('%s', prev_timestamp_str) > 5)
ORDER BY
Extracted_Timestamp DESC;
"
# Execute the query and store the results in a data frame
df_results <- dbGetQuery(con, sql_query)
message(paste("\nSuccessfully executed query and retrieved", nrow(df_results), "rows."))
### ------------------------------------------------------------------------- ###
### 3. EXPORT RESULTS TO CSV                                                  ###
### ------------------------------------------------------------------------- ###
# Define the name and path for your output file. This will save it in your current working directory.
output_file <- "query_results_final_9_1.csv"
# Write the data frame to a CSV file.
# row.names = FALSE prevents R from adding an unnecessary index column.
# na = "" writes empty strings for any NA values.
write.csv(df_results, file = output_file, row.names = FALSE, na = "")
message(paste("Successfully exported data to:", output_file))
### ------------------------------------------------------------------------- ###
### 4. DISCONNECT FROM DATABASES                                              ###
### ------------------------------------------------------------------------- ###
dbExecute(con, "DETACH DATABASE attached_db_1;")
dbExecute(con, "DETACH DATABASE attached_db_2;")
dbDisconnect(con)
message("Disconnected from all SQLite databases.")
